// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Status {
  INITIATED
  PROCESSING
  COMPLETED
  CANCELLED
  PENDING_APPROVAL
}

enum Mode {
  ONLINE
  OFFLINE
  CHEQUE
}

enum ZoneType {
  BULK
  HIGH_BAY
  COLD_CHAIN
  PICK_PACK
}

enum RMAStatus {
  REQUESTED
  RECEIVED
  INSPECTED
  SETTLED
}

enum RMADisposition {
  RESTOCK
  REWORK
  SCRAP
  QUARANTINE
}

model CompanyGroup {
  companyGroupId String    @id @default(auto()) @map("_id") @db.ObjectId
  groupName      String
  groupCode      String    @unique
  description    String?
  logoUrl        String?
  industry       String?
  country        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  companies      Company[]
  users          User[]
}

model Company {
  companyId      String        @id @default(auto()) @map("_id") @db.ObjectId
  companyName    String
  companyCode    String        @unique
  companyDomain  String?
  logoUrl        String?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Multi-Tenancy Grouping
  companyGroupId String?       @db.ObjectId
  companyGroup   CompanyGroup? @relation(fields: [companyGroupId], references: [companyGroupId])

  // Relations
  users          User[]
  products       Product[]
  warehouses     Warehouse[]
  locations      Location[]
  inventories    Inventory[]
  customers      Customer[]
  providers      Provider[]
  orders         Order[]
  deliveries     Delivery[]
  transfers      Transfer[]
  payments       Payment[]
  transactions   Transaction[]
  goodsReceipts  GoodsReceipt[]
  vendorInvoices VendorInvoice[]
  approvalQueues ApprovalQueue[]
  zones          Zone[]
  binLocations   BinLocation[]
  batches        Batch[]
  rmas           RMA[]
}

model User {
  userId           String        @id @default(auto()) @map("_id") @db.ObjectId
  userEmail        String        @unique
  userPassword     String
  userName         String
  userRole         Role?
  userRefreshToken String?
  lastLogin        DateTime?
  ssoProvider      String?

  // Multi-Tenancy Group & Company
  companyGroupId   String?       @db.ObjectId
  companyGroup     CompanyGroup? @relation(fields: [companyGroupId], references: [companyGroupId])
  companyId        String?       @db.ObjectId
  company          Company?      @relation(fields: [companyId], references: [companyId])

  // BackRelation
  Transaction      Transaction[]
}

model Product {
  ProductID          String           @id @default(auto()) @map("_id") @db.ObjectId
  ProductCode        String           @unique
  BarCode            String
  ProductName        String
  ProductDescription String
  ProductCategory    String
  ReorderQuantity    Int?
  PackedWeight       Float?
  PackedHeight       Float?
  PackedWidth        Float?
  PackedDepth        Float?
  Refrigerated       Boolean?
  CostPrice          Float
  SellPrice          Float
  MaxretailPrice     Float
  // Multi-Tenancy
  companyId          String?          @db.ObjectId
  company            Company?         @relation(fields: [companyId], references: [companyId])
  // BackRelation
  OrderDetail        Orderdetail[]
  Transfer           Transfer[]
  Inventory          Inventory[]
  DeliveryDetail     DeliveryDetail[]
  goodsReceiptItems  GoodsReceiptItem[]
  invoiceItems       InvoiceItem[]
  batches            Batch[]
  RMADetails         RMADetail[]
}

model Location {
  LocationID      String      @id @default(auto()) @map("_id") @db.ObjectId
  LocationName    String
  LocationAddress String
  // Multi-Tenancy
  companyId       String?     @db.ObjectId
  company         Company?    @relation(fields: [companyId], references: [companyId])
  // BackRelation
  Warehouse       Warehouse[]
}

model Warehouse {
  WarehouseID    String      @id @default(auto()) @map("_id") @db.ObjectId
  WarehouseName  String
  isRefrigerated Boolean
  // Relation
  LocationID     String      @db.ObjectId
  Location       Location    @relation(fields: [LocationID], references: [LocationID])
  // Multi-Tenancy
  companyId      String?     @db.ObjectId
  company        Company?    @relation(fields: [companyId], references: [companyId])
  // Backrelation
  OutTransfer    Transfer[]  @relation("OutWarehouseTransfers")
  InTransfer     Transfer[]  @relation("InWarehouseTransfers")
  Inventory      Inventory[]
  deliveries     Delivery[]
  goodsReceipts  GoodsReceipt[]
  zones          Zone[]
  binLocations   BinLocation[]
}

model Inventory {
  InventoryID        String    @id @default(auto()) @map("_id") @db.ObjectId
  InventoryAvailable Int
  MinStockLevel      Int
  MaxStockLevel      Int
  ReorderPoint       Int
  // Relation
  ProductID          String    @db.ObjectId
  Product            Product   @relation(fields: [ProductID], references: [ProductID])
  WarehouseID        String       @db.ObjectId
  Warehouse          Warehouse    @relation(fields: [WarehouseID], references: [WarehouseID])
  BinID              String?      @db.ObjectId
  BinLocation        BinLocation? @relation(fields: [BinID], references: [BinID])
  BatchID            String?      @db.ObjectId
  Batch              Batch?       @relation(fields: [BatchID], references: [BatchID])
  // Multi-Tenancy
  companyId          String?   @db.ObjectId
  company            Company?  @relation(fields: [companyId], references: [companyId])
}

model Customer {
  CustomerID      String     @id @default(auto()) @map("_id") @db.ObjectId
  CustomerName    String
  CustomerAddress String
  // Multi-Tenancy
  companyId       String?    @db.ObjectId
  company         Company?   @relation(fields: [companyId], references: [companyId])
  // BackRelation
  Delivery        Delivery[]
  RMAs            RMA[]
}

model Delivery {
  DeliveryID     String           @id @default(auto()) @map("_id") @db.ObjectId
  SalesDate      DateTime
  // Relation
  CustomerID     String           @db.ObjectId
  Customer       Customer         @relation(fields: [CustomerID], references: [CustomerID])
  WarehouseID    String?          @db.ObjectId
  Warehouse      Warehouse?       @relation(fields: [WarehouseID], references: [WarehouseID])
  // Multi-Tenancy
  companyId      String?          @db.ObjectId
  company        Company?         @relation(fields: [companyId], references: [companyId])
  // BackRelation
  DeliveryDetail DeliveryDetail[]
  Payments       Payment[]
}

model DeliveryDetail {
  DeliveryDetailID String    @id @default(auto()) @map("_id") @db.ObjectId
  DeliveryQuantity Int
  ExpectedDate     DateTime
  ActualDate       DateTime?
  // Relation
  ProductID        String    @db.ObjectId
  Product          Product   @relation(fields: [ProductID], references: [ProductID])
  DeliveryID       String    @db.ObjectId
  Delivery         Delivery  @relation(fields: [DeliveryID], references: [DeliveryID])
}

model Provider {
  ProviderID      String  @id @default(auto()) @map("_id") @db.ObjectId
  ProviderName    String
  ProviderAddress String
  // Multi-Tenancy
  companyId       String? @db.ObjectId
  company         Company? @relation(fields: [companyId], references: [companyId])
  // BackRelation
  Order           Order[]
  vendorInvoices  VendorInvoice[]
}

model Order {
  OrderID        String          @id @default(auto()) @map("_id") @db.ObjectId
  OrderDate      DateTime
  Status         Status?         @default(INITIATED)
  OrderStatus    Status?         @default(INITIATED)
  TotalNet       Float?
  TotalTax       Float?
  TotalAmount    Float?
  CreatedBy      String?
  // Relation 
  ProviderID     String          @db.ObjectId
  Provider       Provider        @relation(fields: [ProviderID], references: [ProviderID])
  // Multi-Tenancy
  companyId      String?         @db.ObjectId
  company        Company?        @relation(fields: [companyId], references: [companyId])
  // BackRelation
  Orderdetail    Orderdetail[]
  Payments       Payment[]
  GoodsReceipts  GoodsReceipt[]
  VendorInvoices VendorInvoice[]
  RMAs           RMA[]
}

model Orderdetail {
  OrderDetailID String    @id @default(auto()) @map("_id") @db.ObjectId
  OrderQuantity Int
  UnitPrice     Float?
  TaxRate       Float?
  LineTotal     Float?
  ExpectedDate  DateTime
  ActualDate    DateTime?
  // Relation
  ProductIDs    String[]  @db.ObjectId
  Products      Product?  @relation(fields: [ProductIDs], references: [ProductID])
  OrderID       String    @db.ObjectId
  Order         Order     @relation(fields: [OrderID], references: [OrderID])
}

model Transfer {
  TransferID       String    @id @default(auto()) @map("_id") @db.ObjectId
  TransferQuantity Int
  SentDate         DateTime
  RecievedDate     DateTime?
  TransferStatus   String?   @default("IN_TRANSIT")
  // Relation
  ProductID        String    @db.ObjectId
  Product          Product   @relation(fields: [ProductID], references: [ProductID])
  OutWarehouseID   String    @db.ObjectId
  OutWarehouse     Warehouse @relation("OutWarehouseTransfers", fields: [OutWarehouseID], references: [WarehouseID])
  InWarehouseID    String    @db.ObjectId
  InWarehouse      Warehouse @relation("InWarehouseTransfers", fields: [InWarehouseID], references: [WarehouseID])
  // Multi-Tenancy
  companyId        String?   @db.ObjectId
  company          Company?  @relation(fields: [companyId], references: [companyId])
}

model Payment {
  PaymentID          String    @id @default(auto()) @map("_id") @db.ObjectId
  PaymentAmount      Float
  PaymentStatus      Status    @default(INITIATED)
  PaymentMode        Mode?
  PaymentDescription String?
  CreatedBy          String?
  // Multi-Tenancy
  companyId          String?   @db.ObjectId
  company            Company?  @relation(fields: [companyId], references: [companyId])
  // Relation
  OrderID            String?   @db.ObjectId
  Order              Order?    @relation(fields: [OrderID], references: [OrderID])
  DeliveryID         String?   @map("DeileveryID") @db.ObjectId
  Delivery           Delivery? @relation(fields: [DeliveryID], references: [DeliveryID])
}

model Transaction {
  TransactionID     String   @id @default(auto()) @map("_id") @db.ObjectId
  TransactionDetail String
  // Multi-Tenancy
  companyId         String?  @db.ObjectId
  company           Company? @relation(fields: [companyId], references: [companyId])
  // Relation
  UserID            String   @db.ObjectId
  TransactionOwner  User     @relation(fields: [UserID], references: [userId])
}

model GoodsReceipt {
  GoodsReceiptID   String             @id @default(auto()) @map("_id") @db.ObjectId
  OrderID          String             @db.ObjectId
  Order            Order              @relation(fields: [OrderID], references: [OrderID])
  WarehouseID      String?            @db.ObjectId
  Warehouse        Warehouse?         @relation(fields: [WarehouseID], references: [WarehouseID])
  ReceivedDate     DateTime           @default(now())
  InspectionStatus String             @default("PASSED")
  ReceivedBy       String?
  companyId        String?            @db.ObjectId
  company          Company?           @relation(fields: [companyId], references: [companyId])
  items            GoodsReceiptItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model GoodsReceiptItem {
  GoodsReceiptItemID String       @id @default(auto()) @map("_id") @db.ObjectId
  GoodsReceiptID     String       @db.ObjectId
  GoodsReceipt       GoodsReceipt @relation(fields: [GoodsReceiptID], references: [GoodsReceiptID], onDelete: Cascade)
  ProductID          String       @db.ObjectId
  Product            Product      @relation(fields: [ProductID], references: [ProductID])
  QuantityOrdered    Int
  QuantityReceived   Int
  QuantityDamaged    Int          @default(0)
  Disposition        String?      @default("ACCEPTED")
}

model VendorInvoice {
  InvoiceID     String        @id @default(auto()) @map("_id") @db.ObjectId
  OrderID       String?       @db.ObjectId
  Order         Order?        @relation(fields: [OrderID], references: [OrderID])
  ProviderID    String?       @db.ObjectId
  Provider      Provider?     @relation(fields: [ProviderID], references: [ProviderID])
  InvoiceNumber String
  InvoiceDate   DateTime      @default(now())
  DueDate       DateTime?
  Subtotal      Float
  Tax           Float         @default(0)
  TotalAmount   Float
  MatchStatus   String        @default("MATCH_PENDING")
  MatchNotes    String?
  companyId     String?       @db.ObjectId
  company       Company?      @relation(fields: [companyId], references: [companyId])
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  InvoiceItemID String        @id @default(auto()) @map("_id") @db.ObjectId
  InvoiceID     String        @db.ObjectId
  VendorInvoice VendorInvoice @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade)
  ProductID     String        @db.ObjectId
  Product       Product       @relation(fields: [ProductID], references: [ProductID])
  QuantityBilled Int
  UnitPrice     Float
  LineTotal     Float
}

model ApprovalQueue {
  ApprovalID      String    @id @default(auto()) @map("_id") @db.ObjectId
  EntityType      String
  EntityID        String
  RequestedAmount Float
  Status          String    @default("PENDING")
  RequestedBy     String
  ApprovedBy      String?
  ApprovalNotes   String?
  companyId       String?   @db.ObjectId
  company         Company?  @relation(fields: [companyId], references: [companyId])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Zone {
  ZoneID       String        @id @default(auto()) @map("_id") @db.ObjectId
  ZoneName     String
  ZoneType     ZoneType      @default(BULK)
  WarehouseID  String        @db.ObjectId
  Warehouse    Warehouse     @relation(fields: [WarehouseID], references: [WarehouseID])
  companyId    String?       @db.ObjectId
  company      Company?      @relation(fields: [companyId], references: [companyId])
  BinLocations BinLocation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model BinLocation {
  BinID        String      @id @default(auto()) @map("_id") @db.ObjectId
  BinCode      String
  Aisle        String
  Rack         String
  Shelf        String
  Bin          String
  MaxWeightKg  Float?
  MaxVolumeCbm Float?
  ZoneID       String      @db.ObjectId
  Zone         Zone        @relation(fields: [ZoneID], references: [ZoneID])
  WarehouseID  String      @db.ObjectId
  Warehouse    Warehouse   @relation(fields: [WarehouseID], references: [WarehouseID])
  companyId    String?     @db.ObjectId
  company      Company?    @relation(fields: [companyId], references: [companyId])
  Inventory    Inventory[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Batch {
  BatchID           String      @id @default(auto()) @map("_id") @db.ObjectId
  BatchNumber       String
  ProductID         String      @db.ObjectId
  Product           Product     @relation(fields: [ProductID], references: [ProductID])
  ManufacturingDate DateTime
  ExpiryDate        DateTime
  SupplierLotNumber String?
  QualityStatus     String      @default("RELEASED")
  companyId         String?     @db.ObjectId
  company           Company?    @relation(fields: [companyId], references: [companyId])
  Inventory         Inventory[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model RMA {
  RMAID      String       @id @default(auto()) @map("_id") @db.ObjectId
  RMANumber  String       @unique
  CustomerID String       @db.ObjectId
  Customer   Customer     @relation(fields: [CustomerID], references: [CustomerID])
  OrderID    String?      @db.ObjectId
  Order      Order?       @relation(fields: [OrderID], references: [OrderID])
  Reason     String
  Status     RMAStatus    @default(REQUESTED)
  companyId  String?      @db.ObjectId
  company    Company?     @relation(fields: [companyId], references: [companyId])
  RMADetails RMADetail[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model RMADetail {
  RMADetailID      String          @id @default(auto()) @map("_id") @db.ObjectId
  RMAID            String          @db.ObjectId
  RMA              RMA             @relation(fields: [RMAID], references: [RMAID])
  ProductID        String          @db.ObjectId
  Product          Product         @relation(fields: [ProductID], references: [ProductID])
  QuantityReturned Int
  Disposition      RMADisposition?
  CreditAmount     Float?
  WarehouseID      String?         @db.ObjectId
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

